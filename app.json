{
  "expo": {
    "name": "AbrigoAção",
    "slug": "abrigoacao",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "abrigoacao",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.abrigoacao.app"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
